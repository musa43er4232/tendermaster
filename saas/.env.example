# --- Database ---
# Dev default: local SQLite file. For production use a PostgreSQL URL and
# change `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# --- AI (Anthropic Claude) ---
# Required to enable real AI tender reading, eligibility and document drafting.
# Without it the app runs in MOCK mode (deterministic sample extraction) so the
# full flow is still demoable.
ANTHROPIC_API_KEY=""
# Model used for extraction/generation. Defaults to a capable Claude model.
ANTHROPIC_MODEL="claude-opus-4-8"
