# --- Database ---
# Dev default: local JSON store (no config needed). Production target: PostgreSQL.
DATABASE_URL="file:./dev.db"

# --- AI (Anthropic Claude) ---
# Enables real AI tender reading, eligibility and document drafting.
# Without it the app runs in MOCK mode (deterministic sample extraction).
#
# Preferred name (won't clash with Claude Code's own auth):
TENDERMASTER_ANTHROPIC_API_KEY=""
# Fallback name for pure-local runs:
ANTHROPIC_API_KEY=""
# Optional model override:
ANTHROPIC_MODEL="claude-opus-4-8"

# NOTE: never put a real key in this committed .env.example file.
# Local runs: put it in saas/.env (gitignored).
# Claude Code on the web: add it in your Environment settings (see README).
