# =====================================================================
# TenderMaster app — environment
# Copy to .env for local dev (.env is gitignored). On a host, set these as
# environment variables. Every capability degrades gracefully: with nothing
# set, the app runs as a single open workspace in demo mode.
# =====================================================================

# --- AI (Anthropic Claude) ---
# Enables live tender reading. Preferred name avoids clashing with any
# Claude-Code-own auth; the plain name also works.
TENDERMASTER_ANTHROPIC_API_KEY=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"

# --- Supabase (auth + database + file storage) ---
# From Supabase → Project Settings → API. When these two are set, the app
# requires login. The service-role key is server-only (never exposed).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Stripe (billing) ---
# When these are set (and Supabase is too), logged-in users must have an
# active subscription. Create a $150/mo recurring Price and paste its id.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# --- App URL (used for Stripe redirects & email links) ---
# e.g. https://app.tendermaster.com in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Legacy / dev data store ---
DATABASE_URL="file:./dev.db"
